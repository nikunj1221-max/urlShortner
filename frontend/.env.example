# Frontend Environment Variables
# For local dev backend: http://localhost:3000 (or leave empty if using Vite proxy /api)
# For production backend: https://urlshortner-exex.onrender.com
VITE_API_URL=

# Google OAuth Web Client ID (from Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
